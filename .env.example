# Copiar a .env y completar. El .env real NO se commitea.

NODE_ENV=development
LOG_LEVEL=debug

# Postgres (docker compose up -d levanta uno con estas credenciales)
DATABASE_URL=postgres://fi:fi@localhost:5432/fi_bot

# Redis para BullMQ
REDIS_URL=redis://localhost:6379

# Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp: carpeta donde Baileys guarda la sesión vinculada
WHATSAPP_SESSION_PATH=./.auth

# Telegram: token del bot (obtenerlo con @BotFather). Si no se configura, no arranca el cliente Telegram.
TELEGRAM_BOT_TOKEN=

# Webhook de Telegram: si se completa TELEGRAM_WEBHOOK_URL, el bot recibe los
# updates por webhook en vez de long polling. Dejarlo vacío = long polling
# (comportamiento de siempre, no hace falta nada más).
# URL pública HTTPS completa (ver README > "Telegram por webhook").
TELEGRAM_WEBHOOK_URL=
# Puerto local donde escuchar. Telegram solo acepta 443, 80, 88 u 8443.
TELEGRAM_WEBHOOK_PORT=8443
# Random, para validar que los updates vengan de Telegram de verdad.
TELEGRAM_WEBHOOK_SECRET=

# URL pública de la Mini App (apps/web, deployada en Vercel). Sin esto no se
# ofrece el botón para abrirla.
WEB_APP_URL=

# Scrapper: sistema de salas (MRBS) de la Facultad
SCRAPPER_BASE_URL=https://salas.fi.mdp.edu.ar/index.php
# area=2 => CLASES PRESENCIALES
SCRAPPER_AREA=2
# días hacia adelante que se traen en cada corrida
SCRAPPER_DIAS=7
# todos los días a las 4am, hora de Argentina
SCRAPPER_CRON=0 4 * * *
SCRAPPER_TZ=America/Argentina/Buenos_Aires
# poner en true la primera vez, para no esperar hasta las 4am
SCRAPPER_AL_INICIAR=false

# Rate limiting: máximo de mensajes por usuario en la ventana definida
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_S=60
