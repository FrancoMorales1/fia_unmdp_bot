{
  "name": "@fi/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Esquema Drizzle y acceso a Postgres",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "lint": "eslint src",
    "test": "vitest run",
    "generate": "node ./scripts/drizzle-kit.mjs generate",
    "migrate": "node ./scripts/drizzle-kit.mjs migrate",
    "push": "node ./scripts/drizzle-kit.mjs push",
    "studio": "node ./scripts/drizzle-kit.mjs studio"
  },
  "dependencies": {
    "@fi/core": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
