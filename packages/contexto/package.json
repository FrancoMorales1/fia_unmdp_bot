{
  "name": "@fi/contexto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Base de conocimiento del bot: horarios, calendario, planes de estudio e información de la facultad, armados como contexto para la IA",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@fi/ai": "workspace:*",
    "@fi/core": "workspace:*",
    "@fi/db": "workspace:*",
    "@fi/scrapper": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
