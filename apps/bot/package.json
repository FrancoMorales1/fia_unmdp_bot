{
  "name": "@fi/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Orquestador: WhatsApp -> contexto + BBDD -> IA -> respuesta",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "dev": "tsx watch --conditions development src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@fi/ai": "workspace:*",
    "@fi/core": "workspace:*",
    "@fi/db": "workspace:*",
    "@fi/queue": "workspace:*",
    "@fi/scrapper": "workspace:*",
    "@fi/telegram": "workspace:*",
    "@fi/whatsapp": "workspace:*",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
